# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key (sb_publishable_…) or legacy anon JWT both work
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only — never import these from client components
# Secret key (sb_secret_…) or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=
# URI from Connect → Session pooler. URL-encode special chars in the password (@ → %40)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
AI_PROVIDER_API_KEY=

# Demo seeding — must stay off in production
ENABLE_DEMO_SEED=false
